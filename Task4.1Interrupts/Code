#include <Wire.h>
#include <BH1750.h>

BH1750 lightMeter;

const int pirPin = 11;
const int switchPin = 7;
const int led1 = 5;
const int led2 = 8;

volatile bool motionDetected = false;
volatile bool switchTriggered = false;

bool manualMode = false;
bool lightsAreOn = false;

unsigned long lightOnTime = 0;
const unsigned long onDuration = 5000;

void setup() {
  Serial.begin(9600);

  pinMode(pirPin, INPUT);
  pinMode(switchPin, INPUT_PULLUP);
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);

  Wire.begin();
  lightMeter.begin();

  attachInterrupt(digitalPinToInterrupt(pirPin), motionISR, RISING);
  attachInterrupt(digitalPinToInterrupt(switchPin), switchISR, CHANGE);

  Serial.println("System started...");
}

void loop() {
  float lux = lightMeter.readLightLevel();
  int switchState = digitalRead(switchPin);

  Serial.print("Lux: ");
  Serial.print(lux);
  Serial.print(" | Switch: ");
  Serial.print(switchState);
  Serial.print(" | switchTriggered: ");
  Serial.println(switchTriggered);

  if (switchState == LOW) {
    manualMode = true;
    lightsAreOn = true;
    turnOnLights();
    Serial.println("Manual switch ON -> Lights ON");
  }

  if (switchState == HIGH && manualMode) {
    manualMode = false;
    lightsAreOn = false;
    turnOffLights();
    Serial.println("Manual switch OFF -> Lights OFF");
  }

  if (motionDetected) {
    motionDetected = false;
    Serial.println(">>> INTERRUPT: Motion detected");

    if (!manualMode && lux < 50) {
      turnOnLights();
      lightsAreOn = true;
      lightOnTime = millis();
      Serial.println("Dark + motion -> Lights ON for 5 seconds");
    }
  }

  if (switchTriggered) {
    switchTriggered = false;
    Serial.println(">>> INTERRUPT: Switch changed");
  }

  if (!manualMode && lightsAreOn && millis() - lightOnTime >= onDuration) {
    turnOffLights();
    lightsAreOn = false;
    Serial.println("Timer expired -> Lights OFF");
  }

  delay(300);
}

void motionISR() {
  motionDetected = true;
}

void switchISR() {
  switchTriggered = true;
}

void turnOnLights() {
  digitalWrite(led1, HIGH);
  digitalWrite(led2, HIGH);
}

void turnOffLights() {
  digitalWrite(led1, LOW);
  digitalWrite(led2, LOW);
}
}
